{
  "name": "bindmcp",
  "version": "1.0.0",
  "description": "Framework-agnostic gateway to expose, validate, and execute Model Context Protocol (MCP) tools for AI agents.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "webmcp",
    "model",
    "context",
    "protocol",
    "ai",
    "agent",
    "middleware",
    "routing",
    "zod"
  ],
  "author": "Samuel Ayibatarri",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "hono": "^4.13.19",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.cjs"
    },
    "./express": {
      "import": "./dist/express.mjs",
      "require": "./dist/express.cjs"
    },
    "./fetch": {
      "import": "./dist/fetch.mjs",
      "require": "./dist/fetch.cjs"
    },
    "./hono": {
      "import": "./dist/hono.mjs",
      "require": "./dist/hono.cjs"
    },
    "./package.json": "./package.json"
  }
}
